{"_id":"starintel:analysis:wef-smartstart-launch-coalition-depth-3","dataset":"wef","dtype":"analysis","schema_version":"0.9.0","version":1,"date_added":"2026-07-27T20:40:00Z","date_updated":"2026-07-27T20:40:00Z","title":"WEF SmartStart USA launch coalition — depth 3","summary":"The launch coalition links WEF manufacturing leadership to governors, organized labor, industrial automation, workforce services and semiconductor manufacturing; Michigan and Kentucky become priority pilot leads but are not confirmed pilot states.","sources":[{"source_id":"starintel:source:manpowergroup-smartstart-davos-launch-2026"},{"source_id":"starintel:source:wef-north-america-davos-smartstart-2026"},{"source_id":"starintel:source:aft-cte-smartstart-launch-2026"},{"source_id":"starintel:source:nam-blake-moret-smartstart-2026"}],"evidence":[],"data":{"question":"What governance and implementation actors are publicly visible at the SmartStart USA launch?","method":"Cross-check official WEF, ManpowerGroup, AFT and manufacturing-association records.","framework":"Launch-coalition and state-lead mapping with explicit non-confirmation of pilot geography.","scope":"January 2026 SmartStart USA public launch and curriculum network.","input_ids":["starintel:event:smartstart-usa-public-launch-davos-2026","starintel:org:american-federation-of-teachers","starintel:org:rockwell-automation","starintel:org:manpowergroup","starintel:org:micron-technology","starintel:person:kiva-allgood","starintel:person:gretchen-whitmer","starintel:person:andy-beshear","starintel:person:randi-weingarten","starintel:person:blake-moret","starintel:person:becky-frankiewicz","starintel:person:sanjay-mehrotra"],"findings":["The public launch included WEF, the governors of Michigan and Kentucky, AFT, Rockwell Automation, ManpowerGroup and Micron Technology.","WEF states that more than 60 leaders from government, education and labor collaborated on curricula and pathways to credentials, training, internships and hiring.","AFT describes SmartStart as a skills-based high-school curriculum framework.","Rockwell's Blake Moret described the programme as starting in high school and extending through lifelong learning."],"conclusions":["SmartStart has a cross-sector implementation coalition rather than a single corporate sponsor.","Michigan and Kentucky are evidence-based state investigation leads because their governors participated directly in the launch.","Launch participation alone does not confirm state adoption, school selection, procurement or funding."],"recommendations":["Search Michigan and Kentucky education, workforce, procurement, grant and legislative records.","Identify the August 2026 partner high school.","Enumerate the 60-plus curriculum network and distinguish launch speakers from delivery partners.","Map any public contracts or grants separately from convening relationships."],"counterarguments":["Governors may have appeared as national manufacturing-policy voices without committing their states to a pilot.","Companies may have participated in launch discussions without implementing curriculum or funding pilots."],"limitations":["The complete 60-plus leader roster is not public on the reviewed pages.","No pilot school, award or state implementation agreement was identified."],"unresolved":["Pilot state and school.","Funding awards.","Curriculum governance.","Credentials and portal providers.","Roles of individual coalition organizations after launch."],"confidence":0.96},"assessment":{"confidence":0.96,"uncertainty":0.18,"caveats":["Michigan and Kentucky are priority hypotheses, not confirmed pilot locations."]},"handling":{"visibility":"public","handling":"public-source-only","pii":false,"sensitive":false},"verification":{"status":"source-backed-with-bounded-inference","verified":true,"last_reviewed_at":"2026-07-27T20:40:00Z","unresolved":["pilot geography","implementation commitments"]},"lineage":{"derived_from":["starintel:analysis:wef-smartstart-usa-implementation-network-depth-2"],"generation":3},"workflow":{"research_status":"completed","queue":"wef-auto-dig","priority":0.99,"recursion_depth":3,"max_depth":5,"root_target_id":"starintel:investigation-target:wef-ecp-fall-2026-public-applicant-cluster","completed_at":"2026-07-27T20:40:00Z","next_action":"Verify Michigan and Kentucky implementation evidence."},"tags":["wef","smartstart","launch-coalition","state-leads","depth-3"]}
