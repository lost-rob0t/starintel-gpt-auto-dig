{"_id":"c:provider-implementation-varies","dataset":"cia","dtype":"claim","schema_version":"0.9.0","version":1,"date_added":"2026-07-31T03:34:00-04:00","date_updated":"2026-07-31T03:34:00-04:00","sources":[{"source_id":"s:microsoft-law-enforcement-conference-2008"},{"source_id":"s:intch-brian-faucher"},{"source_id":"s:wired-google-secure-ftp"},{"source_id":"s:google-lers-official"},{"source_id":"s:linkedin-chris-thomas-meta"}],"evidence":[],"data":{"claim":"Public records show company-specific compliance and transfer mechanisms rather than one publicly demonstrated uniform provider architecture: Microsoft Global Criminal Compliance tooling, Google secure FTP or in-person delivery, Google LERS, and a later Meta/WhatsApp request-and-download portal.","subject_ids":["o:microsoft","o:google","o:meta","e:prism-section702"],"claim_type":"cross-source-technical-assessment","status":"verified-bounded"}}
