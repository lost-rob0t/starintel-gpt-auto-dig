{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "brave": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@brave/brave-search-mcp-server@2.1.0",
        "--transport",
        "stdio"
      ],
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      },
      "timeout": 60000
    },
    "fetch": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-fetch-server@1.1.2"
      ],
      "environment": {
        "DEFAULT_LIMIT": "50000"
      },
      "timeout": 60000
    }
  }
}
