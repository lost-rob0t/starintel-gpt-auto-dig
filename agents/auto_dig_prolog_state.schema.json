{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starintel.actor/schemas/auto-dig-prolog-state.v1.json",
  "title": "Auto-Dig Prolog actor state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "last_issue",
    "last_priority",
    "last_branch",
    "last_run_id",
    "last_success_at"
  ],
  "properties": {
    "schema": {
      "const": "auto-dig-prolog-state.v1"
    },
    "last_issue": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "last_priority": {
      "type": ["string", "null"],
      "enum": ["urgent", "high", "normal", "low", null]
    },
    "last_branch": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "last_run_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "last_success_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/coverageLedger"
      }
    }
  },
  "$defs": {
    "coverageItems": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "uniqueItems": true
    },
    "coverageLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "corpus",
        "seed_kind",
        "authority",
        "shard",
        "shard_count",
        "shard_index",
        "ordering",
        "completed",
        "in_progress",
        "failed_retryable"
      ],
      "properties": {
        "schema": {
          "const": "auto-dig-coverage-ledger.v1"
        },
        "corpus": {
          "type": "string",
          "minLength": 1
        },
        "seed_kind": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "shard": {
          "type": "string",
          "minLength": 1
        },
        "shard_count": {
          "type": "integer",
          "minimum": 1
        },
        "shard_index": {
          "type": "integer",
          "minimum": 0
        },
        "ordering": {
          "const": "numeric_ascending"
        },
        "completed": {
          "$ref": "#/$defs/coverageItems"
        },
        "in_progress": {
          "$ref": "#/$defs/coverageItems"
        },
        "failed_retryable": {
          "$ref": "#/$defs/coverageItems"
        }
      }
    }
  }
}
