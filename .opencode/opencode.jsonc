{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "timeout": {
      "startup": 30000,
      "catalog": 30000,
      "execution": 600000
    },
    "servers": {
      "starintel-live": {
        "type": "local",
        "command": [
          "python3",
          "agents/starintel_corpus_mcp_server.py",
          "--root",
          "."
        ],
        "cwd": ".",
        "codemode": false,
        "protocol": "legacy",
        "timeout": {
          "startup": 30000,
          "catalog": 30000,
          "execution": 600000
        }
      }
    }
  }
}
